T = int(input())

for i in range(T):

    N, M = map(int, input().split())
    v = list(map(int, input().split()))

    max_value = 0
    min_value = 9999999

    for j in range(N-M+1):

        s = sum(v[j:j+M])

        if max_value <= s:
            max_value = s

        if min_value >= s:
            min_value = s

    print(f"#{i+1} {max_value - min_value}")