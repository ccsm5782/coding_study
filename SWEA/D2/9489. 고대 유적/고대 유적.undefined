T = int(input())

for tc in range(1, T+1):
    M, N = map(int, input().split())
    arr = [list(map(int, input().split())) for _ in range(M)]
    max_len = 0

    for d1 in range(M):
        for d2 in range(N):
            if arr[d1][d2] == 1: # 1인 지점에서 조사

                # 가로 방향 조사
                move_right = 1
                while d2+move_right < N and arr[d1][d2+move_right] == 1:
                    move_right += 1

                # 세로 방향 조사
                move_down = 1
                while d1+move_down < M and arr[d1+move_down][d2] == 1:
                    move_down += 1

                if max_len < max(move_down, move_right):
                    max_len = max(move_down, move_right)

    print(f"#{tc} {max_len}")