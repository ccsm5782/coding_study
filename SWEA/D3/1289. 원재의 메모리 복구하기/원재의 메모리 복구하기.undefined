T = int(input())

for testcase in range(1, T + 1):
    number = input()
    arr = []

    for i in range(len(number)):
        arr.append(int(number[i]))

    # print(arr)

    initial_arr = [0] * len(arr)
    # print(initial_arr)

    cnt = 0
    while arr != initial_arr: # 이 둘이 다를 때
        # 다른 인덱스 idx 찾기
        for idx in range(len(arr)):
            if arr[idx] != initial_arr[idx]:
                break

        # 만약 다른 지점의 값이 1이라면 모두 0 처리
        if arr[idx] == 1:
            for i in range(idx, len(arr)):
                initial_arr[i] = 1
        else:
            for i in range(idx, len(arr)):
                initial_arr[i] = 0

        cnt += 1

    print(f"#{testcase} {cnt}")