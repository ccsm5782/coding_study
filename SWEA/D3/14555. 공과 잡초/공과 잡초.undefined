N = int(input())
for testcase in range(1, N+1):
    arr = list(input())
    cnt = 0
    for idx in range(len(arr)-1):
        if arr[idx] == '(' and arr[idx+1] == '|':
            arr[idx+1] = ')'
    for idx in range(1,len(arr)):
        if arr[idx] == ')' and arr[idx-1] == '|':
            arr[idx-1] = '('
    for idx in range(len(arr)-1):
        if arr[idx] == '(' and arr[idx+1] == ')':
            cnt += 1

    print(f"#{testcase} {cnt}")