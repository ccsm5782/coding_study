T = 10
for testcase in range(1,T+1):
    N, arr = input().split()
    number = []
    for i in range(len(arr)):
        number.append(int(arr[i]))

    # print(arr)

    while True:
        for i in range(len(number)-1):
            a = -1
            b = -1
            if number[i] == number[i+1]:
                a = number.pop(i)
                b = number.pop(i)
                break
        if a == -1:
            break

    print(f"#{testcase}", end= ' ')
    for i in number:
        print(i, end='')
    print()