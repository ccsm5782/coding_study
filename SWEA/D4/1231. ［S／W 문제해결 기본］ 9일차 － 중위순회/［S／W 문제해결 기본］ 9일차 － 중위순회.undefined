def f(t):
    if tree[t]:
        f(left[t])
        print(tree[t], end='')
        f(right[t])

T = 10
for tc in range(1, T+1):

    # 노드의 수 E와 간선의 수 E
    N = int(input())
    E = N - 1

    # 알파벳을 저장할 tree, 왼쪽 자식을 저장할 left, 오른쪽 자식을 저장할 right, 부모 정보를 저장할 child
    tree = [0] * (N + 1)
    left = [0] * (N + 1)
    right = [0] * (N + 1)
    par = [0] * (N + 1)

    # 8 번의 input을 받아서 4개 배열을 채우는 과정
    for i in range(1, N + 1):
        k = list(input().split())
        if len(k) == 4:
            t = k[1]
            l = int(k[2])
            r = int(k[3])
        elif len(k) == 3:
            t = k[1]
            l = int(k[2])
            r = 0
        elif len(k) == 2:
            t = k[1]
            l = 0
            r = 0

        tree[i] = t
        left[i] = l
        right[i] = r

    print(f"#{tc}", end=' ')
    f(1)
    print()