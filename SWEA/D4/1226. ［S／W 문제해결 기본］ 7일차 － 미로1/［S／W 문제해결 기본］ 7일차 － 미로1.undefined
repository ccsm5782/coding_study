def bfs(g,v):
    visited = [[0] * 16 for _ in range(16)]
    queue = []
    queue.append(v)
    while queue:
        row, col = queue.pop(0)
        if not visited[row][col]:
            visited[row][col] = True
            delta = [[0,1], [1,0], [0,-1], [-1,0]]
            for delta_x, delta_y in delta:
                if 0 <= row + delta_x < 16 and 0 <= col + delta_y < 16 and (g[row + delta_x][col + delta_y] == 0 or g[row+ delta_x][col + delta_y] == 3) and (visited[row + delta_x][col + delta_y] == 0):
                    queue.append((row + delta_x, col + delta_y))
                    if g[row + delta_x][col + delta_y] == 3:
                        return 1
    return 0

            # 그래프를 어떻게 만들어야하는지 모르겠음


for testcase in range(1, 11):
    T = int(input())
    arr = [list(map(int, input())) for _ in range(16)]
    # print(arr)

    # 시작점 찾기
    start_row = start_col = 0
    for row in range(16):
        for col in range(16):
            if arr[row][col] == 2:
                start_row = row
                start_col = col
    # print(start_row, start_col)

    v = (start_row, start_col)
    answer = bfs(arr, v)
    print(f"#{T} {answer}")