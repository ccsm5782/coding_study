def dfs(v):
    visited[v] = 1
    for w in adj_lst[v]:
        if visited[w] == 0:
            dfs(w)
T = 10

for tc in range(1,T+1):
    testcase, c = map(int, input().split())
    graph = list(map(int, input().split()))
    adj_lst = [[] for _ in range(100)]
    visited = [0]*100
    for i in range(c):
        s, e = graph[i*2], graph[i*2 +1]
        adj_lst[s].append(e)
    dfs(0)
    if visited[99] == 1:
        print(f"#{testcase} 1")
    else:
        print(f"#{testcase} 0")
        